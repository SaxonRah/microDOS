.section .text.boot
.align 7

.global _start
.type _start, %function

/*
 * Raspberry Pi Zero 2 W / BCM2710
 *
 * Early diagnostic UART:
 *   mini UART
 *   GPIO14 = TX
 *   GPIO15 = RX
 *   115200 8N1
 *
 * config.txt fixes core_freq at 250 MHz, so:
 *
 *   baud divisor = 250000000 / (8 * 115200) - 1 ~= 270
 */

.equ GPIO_BASE,          0x3F200000
.equ GPFSEL1,            0x04
.equ GPPUD,              0x94
.equ GPPUDCLK0,          0x98

.equ AUX_BASE,           0x3F215000
.equ AUX_ENABLES,        0x04
.equ AUX_MU_IO_REG,      0x40
.equ AUX_MU_IER_REG,     0x44
.equ AUX_MU_IIR_REG,     0x48
.equ AUX_MU_LCR_REG,     0x4C
.equ AUX_MU_MCR_REG,     0x50
.equ AUX_MU_LSR_REG,     0x54
.equ AUX_MU_CNTL_REG,    0x60
.equ AUX_MU_BAUD_REG,    0x68


_start:
    /*
     * Firmware enters all four Cortex-A53 cores.
     * Keep only core 0 alive.
     */
    mrs     x0, mpidr_el1
    and     x0, x0, #0xff
    cbz     x0, 1f

0:
    wfe
    b       0b

1:
    /*
     * No asynchronous exceptions during initial bring-up.
     */
    msr     daifset, #0xf

    /*
     * IMPORTANT:
     * UART setup does not depend on stack, BSS, or C runtime.
     */
    bl      early_uart_init

    mov     w0, #'A'
    bl      early_uart_putc
    mov     w0, #'\r'
    bl      early_uart_putc
    mov     w0, #'\n'
    bl      early_uart_putc

    /*
     * Install stack.
     */
    ldr     x0, =__stack_top
    mov     sp, x0

    mov     w0, #'B'
    bl      early_uart_putc
    mov     w0, #'\r'
    bl      early_uart_putc
    mov     w0, #'\n'
    bl      early_uart_putc

    /*
     * Zero .bss.
     */
    ldr     x0, =__bss_start
    ldr     x1, =__bss_end

2:
    cmp     x0, x1
    b.hs    3f

    str     xzr, [x0], #8
    b       2b

3:
    mov     w0, #'C'
    bl      early_uart_putc
    mov     w0, #'\r'
    bl      early_uart_putc
    mov     w0, #'\n'
    bl      early_uart_putc

    mov     w0, #'D'
    bl      early_uart_putc
    mov     w0, #'\r'
    bl      early_uart_putc
    mov     w0, #'\n'
    bl      early_uart_putc

    /*
     * Enter C.
     */
    bl      kernel_main

    /*
     * kernel_main should never return.
     */
    mov     w0, #'E'
    bl      early_uart_putc
    mov     w0, #'\r'
    bl      early_uart_putc
    mov     w0, #'\n'
    bl      early_uart_putc

4:
    wfe
    b       4b


/*
 * Initialize BCM2837 mini-UART.
 *
 * No stack use.
 */
early_uart_init:
    /*
     * Enable AUX mini UART.
     */
    ldr     x1, =AUX_BASE

    mov     w2, #1
    str     w2, [x1, #AUX_ENABLES]

    /*
     * Disable transmitter/receiver while configuring.
     */
    mov     w2, #0
    str     w2, [x1, #AUX_MU_CNTL_REG]

    /*
     * Disable interrupts.
     */
    str     w2, [x1, #AUX_MU_IER_REG]

    /*
     * 8-bit mode.
     */
    mov     w2, #3
    str     w2, [x1, #AUX_MU_LCR_REG]

    /*
     * RTS high / no modem control.
     */
    mov     w2, #0
    str     w2, [x1, #AUX_MU_MCR_REG]

    /*
     * Clear FIFOs.
     */
    mov     w2, #0xC6
    str     w2, [x1, #AUX_MU_IIR_REG]

    /*
     * 250 MHz core clock -> 115200 baud.
     */
    mov     w2, #270
    str     w2, [x1, #AUX_MU_BAUD_REG]

    /*
     * GPIO14/GPIO15 -> ALT5.
     */
    ldr     x1, =GPIO_BASE

    ldr     w2, [x1, #GPFSEL1]

    mov     w3, #0x3f
    lsl     w3, w3, #12
    bic     w2, w2, w3

    mov     w3, #0x12
    lsl     w3, w3, #12
    orr     w2, w2, w3

    str     w2, [x1, #GPFSEL1]

    /*
     * Disable pulls on GPIO14/GPIO15 using the BCM2837 legacy
     * pull-control sequence.
     */
    mov     w2, #0
    str     w2, [x1, #GPPUD]

    mov     w3, #150

5:
    subs    w3, w3, #1
    b.ne    5b

    mov     w2, #0xC000
    str     w2, [x1, #GPPUDCLK0]

    mov     w3, #150

6:
    subs    w3, w3, #1
    b.ne    6b

    mov     w2, #0
    str     w2, [x1, #GPPUDCLK0]

    /*
     * Enable RX + TX.
     */
    ldr     x1, =AUX_BASE
    mov     w2, #3
    str     w2, [x1, #AUX_MU_CNTL_REG]

    ret


/*
 * w0 = byte
 *
 * Wait until TX FIFO can accept a byte, then transmit it.
 * No stack use.
 */
early_uart_putc:
    ldr     x1, =AUX_BASE

7:
    ldr     w2, [x1, #AUX_MU_LSR_REG]
    tbz     w2, #5, 7b

    str     w0, [x1, #AUX_MU_IO_REG]
    ret


.size _start, . - _start
