/* Generated by pico/CMakeLists.txt: flash-resident images for microDOS. */
    /* .flashdata stays in flash in both the default and copy_to_ram layouts */
    .section .flashdata.md_blobs, "a"
    .balign 4
    .global md_blob_msdos_sys
    .global md_blob_msdos_sys_end
md_blob_msdos_sys:
    .incbin "@MICRODOS_PICO_KERNEL@"
md_blob_msdos_sys_end:
    .balign 4
    .global md_blob_disk
    .global md_blob_disk_end
md_blob_disk:
    .incbin "@MICRODOS_PICO_DISK@"
md_blob_disk_end:
